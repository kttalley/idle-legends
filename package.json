{
  "name": "stillmarch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:ui": "node scripts/validate-design-tokens.mjs && node tools/uitest/run.mjs",
    "build:native": "BUILD_TARGET=native tsc && BUILD_TARGET=native vite build",
    "cap:sync": "npm run build:native && npx cap sync ios",
    "ios": "npm run cap:sync && npx cap open ios",
    "icon": "node tools/spritegen/makeAppIcon.mjs",
    "lint:tokens": "node scripts/validate-design-tokens.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@revenuecat/purchases-capacitor": "^13.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
