{
  "name": "stillmarch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:ui": "node scripts/validate-design-tokens.mjs && node tools/uitest/run.mjs",
    "build:native": "BUILD_TARGET=native tsc && BUILD_TARGET=native vite build",
    "cap:sync": "npm run build:native && npx cap sync ios",
    "cap:sync:android": "npm run build:native && npx cap sync android",
    "android:bundle": "npm run cap:sync:android && cd android && ./gradlew bundleRelease",
    "ios": "npm run cap:sync && npx cap open ios",
    "iap-art": "node tools/spritegen/makeIapArt.mjs",
    "iap-shots": "node tools/uitest/shoot-iap.mjs",
    "icon2": "ICON_WRITE=1 node tools/spritegen/makeAppIcon2.mjs",
    "icon": "node tools/spritegen/makeAppIcon.mjs",
    "bundle:duel": "node tools/bundleDuelResolver.mjs",
    "deploy:duel": "npm run bundle:duel && supabase functions deploy duel",
    "lint:tokens": "node scripts/validate-design-tokens.mjs",
    "asc:status": "node tools/asc/appstore.mjs status",
    "asc:sales": "node tools/asc/appstore.mjs sales"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@revenuecat/purchases-capacitor": "^13.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
