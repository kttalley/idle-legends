.vscode/settings.json
.vscode/launch.json
.vscode/*.code-snippets
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS files ───────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Local save / test data ─────────────────────────────────────────────────────
*.save.json
test-saves/
local-data/

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log
local-assets/

# Background-agent scratch worktrees — never part of the project history.
.claude/worktrees/
