# ── Node.js / npm ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build artifacts ────────────────────────────────────────────────────────────
dist/
dist-ssr/
.vite/

# ── Environment files ──────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ── TypeScript build info ──────────────────────────────────────────────────────
*.tsbuildinfo

# ── Editor / IDE ───────────────────────────────────────────────────────────────
