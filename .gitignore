# ── Node.js / npm ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build artifacts ────────────────────────────────────────────────────────────
dist/
dist-ssr/
.vite/

# ── Environment files ──────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ── TypeScript build info ──────────────────────────────────────────────────────
*.tsbuildinfo

# ── Editor / IDE ───────────────────────────────────────────────────────────────
# Keep .vscode/extensions.json (shared recommended extensions)
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-snippets
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS files ───────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Local save / test data ─────────────────────────────────────────────────────
*.save.json
test-saves/
local-data/

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log
local-assets/

# Background-agent scratch worktrees — never part of the project history.
.claude/worktrees/

# Sprite-generation machine-local config (model filenames, GPU ports)
tools/spritegen/config.json

# ── Capacitor / iOS ────────────────────────────────────────────────────────────
# The iOS project IS committed (Info.plist, entitlements, the app icon set) — it is
# real configuration, and regenerating it loses anything set in Xcode. Only the
# derived parts are ignored.
#   ios/App/App/public/ is the copied web build; `npm run cap:sync` rewrites it.
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/DerivedData/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
**/*.xcuserdatad
