# Vite exposes only env vars prefixed with VITE_ to the browser bundle.
# Set this to a reachable Ollama endpoint if you want LLM-generated names/thoughts.
# Leave unset for public builds so the game falls back to deterministic content.
VITE_LLM_URL=<your-ollama-endpoint>

# The chat/whisper system (engine/chatGen.ts, engine/whisper.ts) uses the same endpoint.
# Unset -> ambient heroes speak canned lines and whispers get canned deflections; the
# game is fully playable offline and makes no network call. Pointing a PUBLIC build at a
# personal Ollama box would expose an unauthenticated, unmetered endpoint to every
# player, so keep this in .env.local for local dev.
